# ============================================
# POSHO CREATIVE
# Git Ignore
# ============================================

# Dependencies
node_modules/

# Production builds
dist/
dist-ssr/

# Local environment variables
.env.local
.env.*.local
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Vite cache
.vite/

# Supabase local temporary files
supabase/.temp/
supabase/.branches/

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Local certificates and secrets
*.pem
*.key
*.crt

# Environment files containing private deployment configuration
.env
.env.development.local
.env.test.local
.env.production.local